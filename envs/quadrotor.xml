<!-- The quadrotor. Mass, inertia and timestep are placeholders: they come from the `dynamics` section of
     configs/env.yaml, written into the model when it is loaded (so config overrides and the config saved with
     a trained model keep working). The geoms are for rendering only: contacts are off, and the explicit
     <inertial> means they add no mass or inertia. -->
<mujoco model="quadrotor">
  <option timestep="0.002" gravity="0 0 -9.81" integrator="Euler">
    <flag contact="disable"/>
  </option>

  <visual>
    <global offwidth="1024" offheight="1024"/>
    <headlight ambient="0.45 0.45 0.45" diffuse="0.45 0.45 0.45" specular="0 0 0"/>
    <map haze="0.5"/>
    <rgba haze="0.88 0.92 0.96 1"/>
    <quality offsamples="8"/>
  </visual>

  <asset>
    <texture name="sky" type="skybox" builtin="flat" rgb1="0.88 0.92 0.96" rgb2="0.88 0.92 0.96" width="16" height="16"/>
    <texture name="floor" type="2d" builtin="checker" rgb1="0.72 0.75 0.78" rgb2="0.62 0.65 0.68" width="64" height="64"/>
    <material name="floor" texture="floor" texrepeat="0.5 0.5" texuniform="true" reflectance="0"/> <!-- 1 m squares -->
    <material name="frame" rgba="0.12 0.13 0.15 1" specular="0.2"/>
    <material name="front" rgba="0.85 0.2 0.15 1" specular="0.2"/>
    <material name="rotor" rgba="0.35 0.38 0.42 0.55" specular="0"/>
  </asset>

  <worldbody>
    <light name="sun" directional="true" pos="0 0 10" dir="0.2 0.3 -1" diffuse="0.5 0.5 0.5" specular="0 0 0"/>
    <geom name="floor" type="plane" size="0 0 1" material="floor"/>

    <body name="quad">
      <freejoint/>
      <inertial pos="0 0 0" mass="1" diaginertia="0.01 0.01 0.01"/>
      <geom type="box" size="0.045 0.03 0.012" material="frame"/>
      <!-- X layout, 0.1 m arms; the front (+x) arms are red, so the rotation is easy to see -->
      <geom type="capsule" size="0.007" fromto="0 0 0 0.0707 0.0707 0" material="front"/>
      <geom type="capsule" size="0.007" fromto="0 0 0 0.0707 -0.0707 0" material="front"/>
      <geom type="capsule" size="0.007" fromto="0 0 0 -0.0707 0.0707 0" material="frame"/>
      <geom type="capsule" size="0.007" fromto="0 0 0 -0.0707 -0.0707 0" material="frame"/>
      <geom type="cylinder" size="0.055 0.002" pos="0.0707 0.0707 0.012" material="rotor"/>
      <geom type="cylinder" size="0.055 0.002" pos="0.0707 -0.0707 0.012" material="rotor"/>
      <geom type="cylinder" size="0.055 0.002" pos="-0.0707 0.0707 0.012" material="rotor"/>
      <geom type="cylinder" size="0.055 0.002" pos="-0.0707 -0.0707 0.012" material="rotor"/>
    </body>
  </worldbody>
</mujoco>
